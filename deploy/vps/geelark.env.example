# Copy to /etc/geelark.env, fill in, then:  chmod 600 /etc/geelark.env   (install.sh does the copy and chmod)
# Never commit the filled-in file.

# GeeLark Open API bearer token (use a fresh one for the server; rotate it if it was ever pasted anywhere)
GEELARK_API_TOKEN=

# Apps Script web app URL (ends in /exec) and the SECRET script property you set in the sheet
GEELARK_SHEETS_URL=
GEELARK_SHEETS_SECRET=
